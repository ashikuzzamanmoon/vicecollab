// Prisma schema for GTA Creator Marketplace (public Next.js version).
// PostgreSQL (Neon / Supabase free tier). See README.md for setup.
//
// Model overview:
//   User            — auth account; role is CREATOR, BRAND or ADMIN.
//   CreatorProfile  — a creator's public listing (stats, niches, packages).
//   BrandProfile    — a brand/agency account.
//   Package         — a creator's priced offer (Short / Stream mention / Dedicated video).
//   Booking         — a deal: Requested -> Accepted -> In Production -> Delivered -> Paid.
//   Message         — per-deal thread between brand and creator.
//   Review          — brand rates a creator once the deal is Paid.
//   PlatformSetting — single row (id 1): admin-configurable commission rate.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and
// in the PrismaPg adapter (lib/prisma.ts) for the runtime client — NOT here.
datasource db {
  provider = "postgresql"
}

enum Role {
  CREATOR
  BRAND
  ADMIN
}

enum Platform {
  YOUTUBE
  TIKTOK
  TWITCH
  KICK
  INSTAGRAM
}

enum PackageType {
  SHORT
  STREAM_MENTION
  DEDICATED_VIDEO
  CUSTOM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DealStatus {
  REQUESTED
  ACCEPTED
  IN_PRODUCTION
  DELIVERED
  PAID
  DECLINED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYONEER
  PAYPAL
  OTHER
}

enum PaymentStatus {
  NOT_STARTED
  PENDING
  CONFIRMED
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models — required by @auth/prisma-adapter.
// Sessions use the JWT strategy (see auth.ts), so the Session table is kept
// for adapter compatibility but is not used at runtime.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CREATOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?
  messages       Message[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Marketplace models
// ---------------------------------------------------------------------------

model CreatorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  tagline            String?
  bio                String?            @db.Text
  avatarUrl          String?
  bannerUrl          String?
  platforms          Platform[]
  primaryPlatform    Platform
  followers          Int                @default(0)
  avgViews           Int                @default(0)
  engagementRate     Float              @default(0)
  audienceCountries  String[]
  niches             String[]
  portfolioLinks     String[]
  verificationStatus VerificationStatus @default(PENDING)
  featured           Boolean            @default(false)
  isPublished        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  packages Package[]
  bookings Booking[]
  reviews  Review[]

  @@index([isPublished, verificationStatus])
  @@index([primaryPlatform])
}

model BrandProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  website     String?
  description String?  @db.Text
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]
  reviews  Review[]
}

model Package {
  id           String      @id @default(cuid())
  creatorId    String
  creator      CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type         PackageType
  title        String
  description  String?     @db.Text
  priceCents   Int
  deliveryDays Int         @default(7)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  bookings Booking[]

  @@index([creatorId])
}

model Booking {
  id              String        @id @default(cuid())
  creatorId       String
  creator         CreatorProfile @relation(fields: [creatorId], references: [id])
  brandId         String
  brand           BrandProfile  @relation(fields: [brandId], references: [id])
  packageId       String?
  package         Package?      @relation(fields: [packageId], references: [id])
  title           String
  brief           String        @db.Text
  priceCents      Int
  commissionRate  Float
  commissionCents Int
  status          DealStatus    @default(REQUESTED)
  deadline        DateTime?
  respondBy       DateTime
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus @default(NOT_STARTED)
  paymentNote     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  messages Message[]
  review   Review?

  @@index([creatorId, status])
  @@index([brandId, status])
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])
  brandId   String
  brand     BrandProfile @relation(fields: [brandId], references: [id])
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([creatorId])
}

model PlatformSetting {
  id             Int      @id @default(1)
  commissionRate Float    @default(15)
  updatedAt      DateTime @updatedAt
}
