# Copy this file to `.env` (local) and fill in real values.
# On Vercel, set the same variables in Project Settings -> Environment Variables.
# NEVER commit a real `.env` file.

# PostgreSQL connection string (Neon or Supabase free tier).
# Neon example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/gta-marketplace?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js secret. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-byte-secret"

# Canonical URL of the app (used by Auth.js for callbacks).
# Local: http://localhost:3000 — Production: https://your-domain.vercel.app
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — sign-in with Google is hidden unless both are set).
# Get these from Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public base URL, used for absolute links in emails/pages.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
